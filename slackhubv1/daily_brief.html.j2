<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"></head>
<body style="font-family:Arial,Helvetica,sans-serif;max-width:700px;margin:0 auto;padding:20px;color:#333;">

<h2 style="color:#1B3A5C;border-bottom:2px solid #1B3A5C;padding-bottom:8px;">
  📋 Your Active TODOs ({{ total_open_todos }} open)
</h2>

{% if open_todos %}
<table style="width:100%;border-collapse:collapse;margin-bottom:16px;" cellpadding="8">
  <tr style="background:#1B3A5C;color:white;">
    <th align="left">Urgency</th>
    <th align="left">Title</th>
    <th align="left">Due</th>
    <th align="left">Link</th>
  </tr>
  {% for todo in open_todos %}
  {% set urg = todo.get('Urgency', 'medium')|lower %}
  {% set bg = '#fee2e2' if urg == 'high' else '#fef9c3' if urg == 'medium' else '#f3f4f6' %}
  {% set icon = '🔴' if urg == 'high' else '🟡' if urg == 'medium' else '🔵' %}
  <tr style="background:{{ bg }};border-bottom:1px solid #e5e7eb;">
    <td>{{ icon }} {{ urg|upper }}</td>
    <td><strong>{{ todo.get('Title', '') }}</strong></td>
    <td>{{ todo.get('Due Date', '') or '—' }}</td>
    <td>{% if todo.get('Thread Link') %}<a href="{{ todo['Thread Link'] }}">[thread]</a>{% endif %}</td>
  </tr>
  {% endfor %}
</table>
{% if sheet_url %}
<p><a href="{{ sheet_url }}">Open full TODO sheet →</a></p>
{% endif %}
{% else %}
<p style="color:#666;">No open TODOs — nice work! 🎉</p>
{% endif %}

<h2 style="color:#1B3A5C;border-bottom:2px solid #1B3A5C;padding-bottom:8px;">
  📊 Yesterday's Activity
</h2>

<table cellpadding="6" style="margin-bottom:16px;">
  <tr><td><strong>Messages sent</strong></td><td>{{ stats.messages_sent }}</td></tr>
  <tr><td><strong>Messages received</strong></td><td>{{ stats.messages_received }}</td></tr>
  <tr><td><strong>Direct @mentions</strong></td><td>{{ stats.direct_mentions }}</td></tr>
  <tr><td><strong>Threads tagged in</strong></td><td>{{ stats.threads_tagged }}</td></tr>
  <tr><td><strong>Threads awaiting response</strong></td><td>{{ stats.threads_awaiting_response }}</td></tr>
  <tr><td><strong>TODOs created</strong></td><td>{{ stats.todos_created }}</td></tr>
  <tr><td><strong>TODOs resolved</strong></td><td>{{ stats.todos_resolved }}</td></tr>
</table>

<h3 style="color:#2E5984;">Channel Activity</h3>
<table cellpadding="4" style="margin-bottom:16px;">
{% for channel, count in stats.channel_volumes|dictsort(by='value', reverse=true) %}
  <tr><td>{{ channel }}</td><td style="font-family:monospace;">{{ count }} msgs</td></tr>
{% endfor %}
</table>

<h2 style="color:#1B3A5C;border-bottom:2px solid #1B3A5C;padding-bottom:8px;">
  🗒️ What Happened Overnight
</h2>
<p>{{ narrative }}</p>

<hr style="border:none;border-top:1px solid #e5e7eb;margin-top:24px;">
<p style="color:#999;font-size:12px;">
  Generated by Slack Intelligence Hub · {{ date.strftime('%b %d, %Y at %I:%M %p') }} UTC
</p>

</body>
</html>
