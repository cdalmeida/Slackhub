# Slack credentials (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token  # only needed for Socket Mode

# GitHub credentials (required for GitHub API calls)
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitHub App credentials (optional, alternative to GITHUB_TOKEN)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Repo → Slack channel mapping
# Format: owner/repo:#channel,owner/other-repo:#other-channel
REPO_CHANNEL_MAP=myorg/myrepo:#engineering,myorg/ops:#devops

# Application settings
PORT=3000
DEBUG=false
LOG_LEVEL=INFO
